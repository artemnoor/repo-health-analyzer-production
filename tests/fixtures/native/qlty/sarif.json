{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "qlty",
          "version": "0.1-fixture",
          "rules": [
            {
              "id": "security/no-secrets",
              "helpUri": "https://example.invalid/rules/no-secrets",
              "defaultConfiguration": {"level": "error"}
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "security/no-secrets",
          "level": "error",
          "message": {"text": "Secret-like value detected"},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "src/config.py"},
                "region": {"startLine": 12, "startColumn": 5, "endLine": 12, "endColumn": 20}
              }
            }
          ],
          "partialFingerprints": {"stable": "fixture-secret-12"}
        }
      ]
    }
  ]
}
