# Repository Health Analyzer source snapshots and generated native outputs
.sources/
.venv/
bin/
vendor/**/target/
vendor/**/build/
vendor/**/.gradle/
vendor/**/.pytest_cache/
vendor/**/__pycache__/
# Junctions from the upstream source snapshots cannot be indexed reliably on Windows.
vendor/chaoss/sirmordred/report
vendor/chaoss/sirmordred/tests/menu.yaml
vendor/qlty/plugins
vendor/sonarqube/logs.sh
vendor/sonarqube/start.sh
vendor/sonarqube/stop.sh
# Windows device-name paths from upstream repositories are not addressable by Git.
vendor/**/aux
vendor/**/aux.*
vendor/**/con
vendor/**/con.*
vendor/**/nul
vendor/**/nul.*
vendor/**/prn
vendor/**/prn.*
vendor/**/com[1-9]
vendor/**/com[1-9].*
vendor/**/lpt[1-9]
vendor/**/lpt[1-9].*
# Keep upstream report renderers; only the explicit Windows junction path
# above remains excluded.
.health-cache/
artifacts/

# Research runs and upstream snapshots are local-only inputs. Keep the small
# README/scripts/provenance files visible, but never stage generated output or
# copied research repositories into the production checkout.
/$out/
spikes/**/runs/
spikes/**/upstream/
spikes/**/controlled-worktrees/
