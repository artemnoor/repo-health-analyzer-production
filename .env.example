# SourceCraft connection (leave URL empty for explicit unavailable-source mode)
SOURCECRAFT_URL=
SOURCECRAFT_TOKEN=
SOURCECRAFT_TIMEOUT_SECONDS=30
SOURCECRAFT_MAX_RETRIES=2

# Backend runtime
REPO_HEALTH_DB=repo-health.sqlite3
REPO_HEALTH_CHECKOUT_ROOT=./checkouts
REPO_HEALTH_WORKER_ID=repo-health-worker-1
LOG_LEVEL=INFO
